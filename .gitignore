# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# IDE
.idea/
.vscode/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python cache files from data-quality tooling
__pycache__/
*.py[cod]

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# legacy Firebase build cache
.firebase/

# typescript
*.tsbuildinfo
next-env.d.ts

# fumadocs
.source/

# dist folders
dist/
/dist/

# standalone server build and local API credentials
/server/
/.env.api-keys

# Reproducible data-sync cache and staging output
.data-sync/
.cache/
/public/data/cities/
/public/data/boundaries/
/public/vendor/maplibre/

# NPM package specific
countrystatecity-npm/dist/
countrystatecity-npm/node_modules/
countrystatecity-npm/test.js
countrystatecity-npm/test-npm-package/
