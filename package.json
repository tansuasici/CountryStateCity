{
  "name": "@tansuasici/country-state-city",
  "version": "3.0.0",
  "type": "module",
  "description": "Versioned country, administrative-area, city, and district data with search, spatial, timezone, export, and MCP APIs.",
  "main": "countrystatecity-npm/dist/index.node.cjs",
  "module": "countrystatecity-npm/dist/index.node.mjs",
  "browser": "countrystatecity-npm/dist/index.browser.js",
  "types": "countrystatecity-npm/dist/index.d.ts",
  "files": [
    "countrystatecity-npm/dist/index.browser.js",
    "countrystatecity-npm/dist/index.node.cjs",
    "countrystatecity-npm/dist/index.node.mjs",
    "countrystatecity-npm/dist/index.d.ts",
    "countrystatecity-npm/dist/types.d.ts",
    "countrystatecity-npm/dist/formatters.d.ts",
    "countrystatecity-npm/dist/location-names.d.ts",
    "countrystatecity-npm/dist/public-id.d.ts",
    "countrystatecity-npm/dist/translations.d.ts",
    "countrystatecity-npm/dist/timezones.d.ts",
    "countrystatecity-npm/dist/reverse-geocoding.d.ts",
    "countrystatecity-npm/dist/search.d.ts",
    "countrystatecity-mcp/dist",
    "data/country.json",
    "data/country-metadata-policy.json",
    "data/schema-normalization-policy.json",
    "data/timezone-policy.json",
    "data/entity-level-policy.json",
    "data/entity-level-report.json",
    "data/state.json",
    "data/city-optimized.json",
    "data/provenance.json",
    "data/production-manifest.json",
    "data/location-display.json",
    "data/identity-policy.json",
    "data/identity/wikidata-qid-policy.json",
    "data/coverage-policy.json",
    "data/coverage-report.json",
    "data/quality-policy.json",
    "data/quality-exceptions.json",
    "data/quality-report.json",
    "data/quality-report.md",
    "data/package-budget.json",
    "data/distribution-manifest.json",
    "data/geography/city-coordinate-policy.json",
    "data/geography/state-coordinate-policy.json",
    "data/geography/reverse-geocoding-policy.json",
    "data/geography/reverse-geocoding-benchmark.json",
    "data/versions/index.json",
    "data/subscriptions/policy.json",
    "data/search",
    "data/contributions",
    "data/sources/natural-earth-admin1-5.1.1.json",
    "data/admin",
    "data/boundaries/manifest.json",
    "data/boundaries/tr/README.md",
    "data/boundaries/tr/turkey-admin-z0-4.json",
    "data/README.md",
    "data/migrations",
    "DATA_LICENSE.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./countrystatecity-npm/dist/index.d.ts",
      "browser": "./countrystatecity-npm/dist/index.browser.js",
      "node": {
        "import": "./countrystatecity-npm/dist/index.node.mjs",
        "require": "./countrystatecity-npm/dist/index.node.cjs"
      },
      "default": "./countrystatecity-npm/dist/index.browser.js"
    },
    "./browser": {
      "types": "./countrystatecity-npm/dist/index.d.ts",
      "default": "./countrystatecity-npm/dist/index.browser.js"
    },
    "./node": {
      "types": "./countrystatecity-npm/dist/index.d.ts",
      "import": "./countrystatecity-npm/dist/index.node.mjs",
      "require": "./countrystatecity-npm/dist/index.node.cjs"
    },
    "./data/countries.json": "./data/country.json",
    "./data/country-metadata-policy.json": "./data/country-metadata-policy.json",
    "./data/schema-normalization-policy.json": "./data/schema-normalization-policy.json",
    "./data/timezone-policy.json": "./data/timezone-policy.json",
    "./data/entity-level-policy.json": "./data/entity-level-policy.json",
    "./data/entity-level-report.json": "./data/entity-level-report.json",
    "./data/states.json": "./data/state.json",
    "./data/cities.optimized.json": "./data/city-optimized.json",
    "./data/districts/tr.json": "./data/admin/districts/tr.json",
    "./data/boundaries/manifest.json": "./data/boundaries/manifest.json",
    "./data/boundaries/tr/overview.json": "./data/boundaries/tr/turkey-admin-z0-4.json",
    "./data/location-display.json": "./data/location-display.json",
    "./data/identity-policy.json": "./data/identity-policy.json",
    "./data/identity/wikidata-qid-policy.json": "./data/identity/wikidata-qid-policy.json",
    "./data/coverage-policy.json": "./data/coverage-policy.json",
    "./data/coverage-report.json": "./data/coverage-report.json",
    "./data/quality-policy.json": "./data/quality-policy.json",
    "./data/quality-exceptions.json": "./data/quality-exceptions.json",
    "./data/quality-report.json": "./data/quality-report.json",
    "./data/package-budget.json": "./data/package-budget.json",
    "./data/distribution-manifest.json": "./data/distribution-manifest.json",
    "./data/geography/city-coordinate-policy.json": "./data/geography/city-coordinate-policy.json",
    "./data/geography/state-coordinate-policy.json": "./data/geography/state-coordinate-policy.json",
    "./data/geography/reverse-geocoding-policy.json": "./data/geography/reverse-geocoding-policy.json",
    "./data/geography/reverse-geocoding-benchmark.json": "./data/geography/reverse-geocoding-benchmark.json",
    "./data/versions/index.json": "./data/versions/index.json",
    "./data/subscriptions/policy.json": "./data/subscriptions/policy.json",
    "./data/search/alias-policy.json": "./data/search/alias-policy.json",
    "./data/search/policy.json": "./data/search/policy.json",
    "./data/search/golden-queries.json": "./data/search/golden-queries.json",
    "./data/contributions/policy.json": "./data/contributions/policy.json",
    "./data/contributions/ledger.json": "./data/contributions/ledger.json",
    "./data/contributions/metrics.json": "./data/contributions/metrics.json",
    "./data/sources/natural-earth-admin1-5.1.1.json": "./data/sources/natural-earth-admin1-5.1.1.json",
    "./data/migrations/index.json": "./data/migrations/index.json",
    "./data/production-manifest.json": "./data/production-manifest.json",
    "./data/provenance.json": "./data/provenance.json",
    "./data/migrations/city-id-migrations.json": "./data/migrations/city-id-migrations.json",
    "./data/migrations/tr-city-to-district.json": "./data/migrations/tr-city-to-district.json",
    "./mcp": "./countrystatecity-mcp/dist/index.js"
  },
  "bin": {
    "country-state-city-mcp": "countrystatecity-mcp/dist/index.js"
  },
  "scripts": {
    "predev": "npm run data:web",
    "dev": "env-cmd -f .env.development next dev --turbopack",
    "prebuild:prod": "npm version patch",
    "build:prod": "npm run data:web && env-cmd -f .env.production next build",
    "build:web": "npm run data:web && next build",
    "postbuild:prod": "git add package.json && git commit -m 'Build(prod): version bump'",
    "build:lib": "rollup -c",
    "build:lib:tsc": "tsc --project tsconfig.lib.json",
    "start": "next start",
    "export": "next export",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:data": "node scripts/validate-data-integrity.mjs",
    "test:data-artifacts": "node scripts/generate-data-artifacts.mjs --check",
    "test:identity": "node scripts/validate-identity-policy.mjs",
    "test:data-sync": "node scripts/validate-data-sync-config.mjs",
    "test:timezones": "node scripts/validate-timezones.mjs",
    "test:data-quality": "node scripts/run-data-quality-gate.mjs --check",
    "test:data-quality-regressions": "node scripts/test-data-quality-regressions.mjs",
    "test:quality-dashboard": "node scripts/generate-quality-dashboard.mjs --check && vitest run lib/quality-dashboard.test.ts",
    "test:package-size": "node scripts/check-package-size.mjs",
    "test:packed-entrypoints": "node scripts/test-packed-entrypoints.mjs",
    "test:web-city-shards": "node scripts/sync-web-city-shards.mjs --check",
    "test:web-boundaries": "node scripts/sync-web-boundaries.mjs --check",
    "test:web-maplibre": "node scripts/sync-maplibre-worker.mjs --check",
    "test:web-flags": "node scripts/sync-country-flags.mjs --check",
    "test:web-version-diffs": "node scripts/sync-version-diffs.mjs --check",
    "test:version-diff": "vitest run lib/version-diff.test.ts countrystatecity-api/src/__tests__/webhooks.test.ts",
    "test:location-search": "vitest run countrystatecity-npm/src/__tests__/search.test.ts countrystatecity-api/src/__tests__/api.test.ts",
    "test:contributions": "node scripts/validate-contribution-workflow.mjs && node scripts/generate-contribution-metrics.mjs --check && vitest run lib/contributions.test.ts",
    "test:city-coordinates": "uv run --with shapely==2.1.2 --with pyshp==2.3.1 --with pyproj==3.7.2 python analysis/audit_city_coordinates.py --offline --check",
    "test:state-coordinates": "uv run --with shapely==2.1.2 --with pyshp==2.3.1 --with pyproj==3.7.2 python analysis/audit_state_coordinates.py --offline --check",
    "test:turkey-boundaries": "node scripts/validate-turkey-boundary-etl.mjs",
    "test:turkey-osm-boundaries": "node scripts/validate-turkey-osm-boundaries.mjs",
    "test:turkey-admin": "node scripts/validate-turkey-admin-source.mjs",
    "test:routes": "node scripts/verify-static-routes.mjs",
    "data:sync": "node scripts/data-sync.mjs",
    "data:display-metadata": "node scripts/generate-location-display-metadata.mjs",
    "data:coverage": "node scripts/generate-coverage-report.mjs",
    "data:artifacts": "node scripts/generate-data-artifacts.mjs",
    "data:normalize-parents": "node scripts/normalize-parent-fields.mjs",
    "data:country-metadata": "node scripts/apply-country-metadata.mjs",
    "data:schema-normalization": "node scripts/apply-schema-normalization.mjs",
    "data:timezones": "node scripts/apply-timezone-policy.mjs",
    "data:quality": "node scripts/run-data-quality-gate.mjs",
    "data:quality-dashboard": "node scripts/generate-quality-dashboard.mjs",
    "data:package-size": "node scripts/check-package-size.mjs --update",
    "data:web-city-shards": "node scripts/sync-web-city-shards.mjs",
    "data:web-boundaries": "node scripts/sync-web-boundaries.mjs",
    "data:web-maplibre": "node scripts/sync-maplibre-worker.mjs",
    "data:web-flags": "node scripts/sync-country-flags.mjs",
    "data:web-version-diffs": "node scripts/sync-version-diffs.mjs",
    "data:web": "npm run data:web-city-shards && npm run data:web-boundaries && npm run data:web-maplibre && npm run data:web-flags && npm run data:web-version-diffs && npm run data:quality-dashboard",
    "data:version-diff": "node scripts/generate-version-diff.mjs",
    "contribution:metrics": "node scripts/generate-contribution-metrics.mjs",
    "contribution:apply": "node scripts/apply-reviewed-correction.mjs",
    "data:entity-levels": "node scripts/apply-entity-levels.mjs",
    "data:check-freshness": "node scripts/check-source-freshness.mjs",
    "data:snapshot-manifest": "node scripts/generate-production-manifest.mjs",
    "data:audit:city-coordinates": "uv run --with shapely==2.1.2 --with pyshp==2.3.1 --with pyproj==3.7.2 python analysis/audit_city_coordinates.py",
    "data:audit:state-coordinates": "uv run --with shapely==2.1.2 --with pyshp==2.3.1 --with pyproj==3.7.2 python analysis/audit_state_coordinates.py",
    "data:audit:wikidata-qids": "node scripts/audit-wikidata-qids.mjs --fetch",
    "data:apply:city-coordinate-corrections": "node scripts/apply-city-coordinate-corrections.mjs",
    "data:migrate:city-ids": "node scripts/apply-city-id-migrations.mjs",
    "data:sync:city-ids": "node scripts/sync-city-id-migrations.mjs",
    "data:sync:turkey-admin": "node scripts/sync-turkey-admin-source.mjs",
    "data:districts:turkey": "node scripts/generate-turkey-district-layer.mjs",
    "data:boundaries:turkey": "uv run --with shapely==2.1.2 --with pyproj==3.7.2 python analysis/build_turkey_osm_boundaries.py --output-dir data/boundaries/tr --report analysis/turkey_osm_boundary_etl_report.json",
    "data:boundaries:turkey:manifest": "node scripts/generate-turkey-osm-boundary-manifest.mjs",
    "prepare": "husky",
    "build:dev": "SET NODE_ENV=dev npm run build --dev --",
    "build:local": "npm run data:web && env-cmd -f .env.local next build",
    "build:mcp": "esbuild countrystatecity-mcp/src/index.ts --bundle --platform=node --format=esm --outfile=countrystatecity-mcp/dist/index.js --external:@modelcontextprotocol/sdk --external:zod --banner:js=\"#!/usr/bin/env node\nimport{fileURLToPath as __mcp_fileURLToPath}from'url';import{dirname as __mcp_dirname}from'path';const __filename=__mcp_fileURLToPath(import.meta.url);const __dirname=__mcp_dirname(__filename);\"",
    "build:api": "node scripts/build-hosted-api.mjs",
    "start:api": "node server/dist/server.mjs",
    "test:api": "vitest run countrystatecity-api/src/__tests__",
    "dev:api": "tsx countrystatecity-api/src/server.ts",
    "dev:mcp": "tsx countrystatecity-mcp/src/index.ts",
    "prepublishOnly": "npm run test:data-artifacts && npm run test:data-quality && npm run test:quality-dashboard && npm run build:lib && npm run build:mcp && npm run test:package-size && npm run test:packed-entrypoints"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "countries",
    "states",
    "cities",
    "json",
    "csv",
    "xml",
    "yaml",
    "location",
    "geography",
    "world-data",
    "iso3166",
    "nextjs",
    "react",
    "typescript"
  ],
  "author": {
