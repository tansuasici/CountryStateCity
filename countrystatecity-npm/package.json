{
  "name": "@tansuasici/country-state-city",
  "version": "3.0.0",
  "private": true,
  "description": "Versioned country, administrative-area, city, and district data with search, spatial, timezone, export, and MCP APIs.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --external:js-yaml --external:xml-js",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --external:js-yaml --external:xml-js",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
    "test": "node test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "country",
    "state",
    "city",
    "location",
    "geography",
    "json",
    "csv",
    "xml",
    "yaml",
    "data",
    "world",
    "countries",
    "states",
    "cities",
    "iso",
    "timezone"
  ],
  "author": "Tansu Asici",
  "license": "MIT",
  "homepage": "https://countrystatecity.tansuasici.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tansuasici/CountryStateCity.git"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "js-yaml": "^5.2.3",
    "xml-js": "^1.6.11"
  }
}
